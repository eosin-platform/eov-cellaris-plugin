#. Translators: where to get ONNX Runtime on Linux; file and release
#. names are not translated.
#: src/runtime.rs:344
msgid ""
"libonnxruntime.so from the onnxruntime-linux release, or your distribution's "
"package"
msgstr ""
"libonnxruntime.so de l'archive onnxruntime-linux, ou le paquet de votre "
"distribution"

#. Translators: {version} is a version number, {platform} says where to
#. get ONNX Runtime for this computer; CELLARIS_ORT_DYLIB is an
#. environment variable (not translated).
#: src/runtime.rs:351
msgid ""
"Install ONNX Runtime {version} or newer ({platform}), then choose it in the "
"Cellaris panel, set CELLARIS_ORT_DYLIB, or put it in the plugin's data "
"directory."
msgstr ""
"Installez ONNX Runtime {version} ou plus récent ({platform}), puis "
"choisissez-le dans le panneau Cellaris, définissez CELLARIS_ORT_DYLIB, ou "
"placez-le dans le dossier de données du plugin."

