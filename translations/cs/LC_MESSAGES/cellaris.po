msgid "{source} points at {path}, which holds no {library}"
msgstr "{source} odkazuje na {path}, kde není žádný soubor {library}"

#. Translators: where to get ONNX Runtime on Windows; file and release
#. names are not translated.
#: src/runtime.rs:334
msgid "onnxruntime.dll from the onnxruntime-win-x64 release"
msgstr "onnxruntime.dll z vydání onnxruntime-win-x64"

#. Translators: where to get ONNX Runtime on macOS; `brew install
#. onnxruntime` is a command, and file and release names are not
#. translated.
#: src/runtime.rs:339
msgid ""
"`brew install onnxruntime`, or libonnxruntime.dylib from the onnxruntime-osx "
"release"
msgstr ""
"`brew install onnxruntime` nebo libonnxruntime.dylib z vydání onnxruntime-osx"

#. Translators: where to get ONNX Runtime on Linux; file and release
#. names are not translated.
#: src/runtime.rs:344
msgid ""
"libonnxruntime.so from the onnxruntime-linux release, or your distribution's "
"package"
msgstr ""
"libonnxruntime.so z vydání onnxruntime-linux nebo balíček vaší distribuce"

#. Translators: {version} is a version number, {platform} says where to
#. get ONNX Runtime for this computer; CELLARIS_ORT_DYLIB is an
#. environment variable (not translated).
#: src/runtime.rs:351
msgid ""
"Install ONNX Runtime {version} or newer ({platform}), then choose it in the "
"Cellaris panel, set CELLARIS_ORT_DYLIB, or put it in the plugin's data "
"directory."
msgstr ""
"Nainstalujte ONNX Runtime {version} nebo novější ({platform}) a poté jej "
"zvolte v panelu Cellaris, nastavte CELLARIS_ORT_DYLIB nebo jej umístěte do "
"datové složky zásuvného modulu."

