export struct ReadoutRow {
    name: string,
    red: int,
    green: int,
    blue: int,
    mean: string,
    density: string,
}

component Action inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 26px;
    border-radius: 4px;
    background: touch.has-hover ? #4a5460 : #3e444c;

    Text {
        text: root.text;
        color: #cccccc;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component CellarisReadout inherits Rectangle {
    in property <string> status: "Pick the region tool and draw a polygon round some tissue.";
    in property <string> detail: "";
    in property <float> progress: 0;
    in property <[ReadoutRow]> rows: [];
    in property <bool> has-region: false;
    callback clear-region();
    callback close-readout();

    background: #252526;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        alignment: start;

        Text {
            text: "Region readout";
            color: #cccccc;
            font-size: 15px;
            font-weight: 600;
        }

        Text {
            text: root.status;
            color: #cccccc;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: #969696;
            font-size: 11px;
            wrap: word-wrap;
        }

        if root.progress > 0 && root.progress < 1: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: #3e3e42;

            Rectangle {
                x: 0;
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: 2px;
                background: #0e639c;
            }
        }

        if root.rows.length > 0: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                Text { text: "marker"; color: #969696; font-size: 11px; horizontal-stretch: 1; }
                Text { text: "mean"; color: #969696; font-size: 11px; width: 48px; horizontal-alignment: right; }
                Text { text: "density r²"; color: #969696; font-size: 11px; width: 72px; horizontal-alignment: right; }
            }

            for row in root.rows: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    width: 10px;
                    Rectangle {
                        height: 10px;
                        border-radius: 2px;
                        background: rgb(row.red, row.green, row.blue);
                    }
                }

                Text { text: row.name; color: #cccccc; font-size: 12px; horizontal-stretch: 1; }
                Text { text: row.mean; color: #cccccc; font-size: 12px; width: 48px; horizontal-alignment: right; }
                Text { text: row.density; color: #cccccc; font-size: 12px; width: 72px; horizontal-alignment: right; }
            }
        }

        Text {
            text: "Mean is the predicted intensity, arcsinh, over tissue in the region. Density r² is how much of its variation between 16px blocks optical density alone reproduces. Near 1, the marker is a density map here. Low is needed for it to be more than that, but only measured IF shows it is the marker.";
            color: #969696;
            font-size: 11px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            if root.has-region: Action {
                text: "Clear";
                clicked => { root.clear-region(); }
            }
            Action {
                text: "Close";
                clicked => { root.close-readout(); }
            }
        }
    }
}
